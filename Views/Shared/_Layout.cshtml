<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Portal de Campañas</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <div class="container app-header__inner">
            <a class="brand" asp-controller="Campanas" asp-action="Index">
                PortalCampañas
            </a>

            <nav class="top-nav">
                <a asp-controller="Campanas" asp-action="Index">Listado</a>
                <a asp-controller="Campanas" asp-action="Index" asp-route-estado="Vigente">Filtrar</a>
                <a asp-controller="Campanas" asp-action="Resumen">Resumen</a>
            </nav>
        </div>
    </header>

    <main class="container main-content">
        @RenderBody()
    </main>

    <footer class="app-footer">
        <div class="container">
            Portal interno de campañas comerciales - Evaluación Continua 1
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>